generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum TaskType {
  NORMAL
  COUNTER
  FORBIDDEN
  CONDITIONAL
  STREAK
}

enum TaskStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CounterValueSource {
  FIXED
  ACTIVITY_INPUT
}

enum ActivityType {
  TASK_COMPLETION
  MANUAL_ADJUSTMENT
  STREAK_EVALUATION
  DAILY_QUESTION_ANSWER
  SYSTEM
}

enum ConditionType {
  TASK_COMPLETIONS
  COUNTER_TOTAL
  STREAK_DAYS
  TAG_PRESENT
}

enum ConditionOperator {
  EQ
  NEQ
  GT
  GTE
  LT
  LTE
}

enum NotificationTargetType {
  ALL_USERS
  TAGS
  USER_IDS
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum DailyQuestionType {
  TEXT
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  BOOLEAN
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

enum MoneyTriggerType {
  MISS_TASK
  COMPLETE_TASK
  DO_FORBIDDEN
  AVOID_FORBIDDEN
}

model User {
  id                     Int                    @id @default(autoincrement())
  email                  String                 @unique
  displayName            String?
  bio                    String?
  avatarUrl              String?
  isStreakPublic         Boolean                @default(true)
  isLeaderboardVisible   Boolean                @default(true)
  role                   UserRole               @default(USER)
  adminPermissions       Json?
  isActive               Boolean                @default(true)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  tags                   UserTag[]
  activities             Activity[]             @relation("ActivityUser")
  moneyCommitments       MoneyCommitment[]
  moneyEntries           MoneyEntry[]
  streaks                Streak[]
  createdTasks           Task[]                 @relation("TaskCreatedBy")
  adminAdjustments       Activity[]             @relation("ActivityCreatedByAdmin")
  adminActionLogs        AdminActionLog[]       @relation("AdminActionActor")
  devices                UserDevice[]
  notificationRecipients NotificationRecipient[]
  dailyQuestionAnswers   DailyQuestionAnswer[]
  createdNotifications   NotificationCampaign[] @relation("NotificationCreatedBy")
  createdDailyQuestions  DailyQuestion[]        @relation("DailyQuestionCreatedBy")
  passwordHash           String?

}

model Tag {
  id                  Int                       @id @default(autoincrement())
  key                 String                    @unique
  label               String
  labelEn             String?
  labelAr             String?
  isActive            Boolean                   @default(true)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  users               UserTag[]
  taskRequirements    TaskTagRequirement[]
  categoryTasks       Task[]                    @relation("TaskCategoryTag")
  conditionTargets    TaskCondition[]           @relation("ConditionTargetTag")
  notificationTargets NotificationCampaignTag[]
}

model UserTag {
  userId    Int
  tagId     Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([userId, tagId])
  @@index([tagId])
}

model CounterDefinition {
  id               Int                  @id @default(autoincrement())
  key              String               @unique
  name             String
  unit             String?
  description      String?
  isActive         Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  taskCounterRules TaskCounterRule[]
  activityDeltas   ActivityCounterDelta[]
  conditionTargets TaskCondition[]      @relation("ConditionTargetCounter")
}

model Task {
  id               Int                  @id @default(autoincrement())
  key              String               @unique
  title            String
  description      String?
  type             TaskType
  status           TaskStatus           @default(ACTIVE)
  basePoints       Decimal              @db.Decimal(10, 2)
  config           Json?
  isPrivate        Boolean              @default(false)
  startsAt         DateTime?
  endsAt           DateTime?
  categoryTagId    Int?
  createdById      Int?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  createdBy        User?                @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  categoryTag      Tag?                 @relation("TaskCategoryTag", fields: [categoryTagId], references: [id], onDelete: SetNull)
  tagRequirements  TaskTagRequirement[]
  dependencies     TaskDependency[]     @relation("TaskDependsOn")
  requiredBy       TaskDependency[]     @relation("TaskRequiredFor")
  counterRules     TaskCounterRule[]
  conditions       TaskCondition[]      @relation("TaskConditions")
  conditionTargets TaskCondition[]      @relation("ConditionTargetTask")
  activities       Activity[]
  moneyCommitments MoneyCommitment[]
  moneyEntries     MoneyEntry[]
  streaks          Streak[]

  @@index([type, status])
  @@index([startsAt, endsAt])
  @@index([categoryTagId])
}

model TaskTagRequirement {
  taskId    Int
  tagId     Int
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@index([tagId])
}

model TaskDependency {
  id              Int      @id @default(autoincrement())
  taskId          Int
  dependsOnTaskId Int
  minCompletions  Int      @default(1)
  withinDays      Int?
  createdAt       DateTime @default(now())
  task            Task     @relation("TaskDependsOn", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask   Task     @relation("TaskRequiredFor", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@index([dependsOnTaskId])
}

model TaskCounterRule {
  id            Int                @id @default(autoincrement())
  taskId        Int
  counterId     Int
  valueSource   CounterValueSource @default(FIXED)
  fixedDelta    Decimal?           @db.Decimal(10, 2)
  allowNegative Boolean            @default(false)
  metadata      Json?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  task          Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  counter       CounterDefinition  @relation(fields: [counterId], references: [id], onDelete: Cascade)

  @@unique([taskId, counterId])
  @@index([counterId])
}

model TaskCondition {
  id              Int               @id @default(autoincrement())
  taskId          Int
  type            ConditionType
  operator        ConditionOperator @default(GTE)
  value           Decimal           @db.Decimal(10, 2)
  targetTaskId    Int?
  targetCounterId Int?
  targetTagId     Int?
  withinDays      Int?
  createdAt       DateTime          @default(now())
  task            Task              @relation("TaskConditions", fields: [taskId], references: [id], onDelete: Cascade)
  targetTask      Task?             @relation("ConditionTargetTask", fields: [targetTaskId], references: [id], onDelete: SetNull)
  targetCounter   CounterDefinition? @relation("ConditionTargetCounter", fields: [targetCounterId], references: [id], onDelete: SetNull)
  targetTag       Tag?              @relation("ConditionTargetTag", fields: [targetTagId], references: [id], onDelete: SetNull)

  @@index([taskId, type])
  @@index([targetTaskId])
  @@index([targetCounterId])
  @@index([targetTagId])
}

model Activity {
  id                Int                    @id @default(autoincrement())
  userId            Int
  taskId            Int?
  type              ActivityType
  occurredAt        DateTime               @default(now())
  timezone          String                 @default("Africa/Cairo")
  isDuringFasting   Boolean                @default(false)
  fastingMultiplier Decimal                @default(1.00) @db.Decimal(4, 2)
  basePoints        Decimal                @default(0) @db.Decimal(10, 2)
  effectivePoints   Decimal                @default(0) @db.Decimal(10, 2)
  note              String?
  metadata          Json?
  isForbidden       Boolean                @default(false)
  createdByAdminId  Int?
  createdAt         DateTime               @default(now())
  user              User                   @relation("ActivityUser", fields: [userId], references: [id], onDelete: Cascade)
  task              Task?                  @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdByAdmin    User?                  @relation("ActivityCreatedByAdmin", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  counterDeltas     ActivityCounterDelta[]

  @@index([userId, occurredAt])
  @@index([taskId, occurredAt])
  @@index([type, occurredAt])
  @@index([isForbidden])
}

model Streak {
  id                   Int      @id @default(autoincrement())
  userId               Int
  taskId               Int
  currentStreak        Int      @default(0)
  longestStreak        Int      @default(0)
  graceDaysUsed        Int      @default(0)
  rewardMultiplier     Decimal  @default(1.00) @db.Decimal(4, 2)
  lastActivityDate     DateTime? @db.Date
  lastEvaluatedAt      DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task                 Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
  @@index([taskId])
  @@index([userId, updatedAt])
}

model ActivityCounterDelta {
  id         Int               @id @default(autoincrement())
  activityId Int
  counterId  Int
  delta      Decimal           @db.Decimal(12, 2)
  createdAt  DateTime          @default(now())
  activity   Activity          @relation(fields: [activityId], references: [id], onDelete: Cascade)
  counter    CounterDefinition @relation(fields: [counterId], references: [id], onDelete: Cascade)

  @@unique([activityId, counterId])
  @@index([counterId, createdAt])
}

model MoneyCommitment {
  id            Int      @id @default(autoincrement())
  userId        Int
  taskId        Int
  triggerType   MoneyTriggerType
  amount        Decimal  @db.Decimal(10, 2)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task          Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId, triggerType])
  @@index([taskId])
}

model MoneyEntry {
  id            Int             @id @default(autoincrement())
  userId        Int
  taskId        Int
  triggerType   MoneyTriggerType
  amount        Decimal         @db.Decimal(10, 2)
  date          DateTime        @db.Date
  reason        String
  removedAt     DateTime?
  removedReason String?
  createdAt     DateTime        @default(now())
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  task          Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId, date, triggerType])
  @@index([userId, date])
}

model FastingWindow {
  id        Int      @id @default(autoincrement())
  date      DateTime @db.Date
  timezone  String   @default("Africa/Cairo")
  fajrAt    DateTime
  maghribAt DateTime
  source    String
  fetchedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, timezone])
  @@index([timezone, date])
}

model AdminActionLog {
  id         Int      @id @default(autoincrement())
  adminId    Int
  action     String
  entityType String
  entityId   String?
  summary    String?
  payload    Json?
  createdAt  DateTime @default(now())
  admin      User     @relation("AdminActionActor", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, createdAt])
  @@index([entityType, entityId])
}

model AppSetting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NotificationCampaign {
  id           Int                    @id @default(autoincrement())
  title        String
  body         String
  targetType   NotificationTargetType @default(ALL_USERS)
  filters      Json?
  scheduledFor DateTime?
  sentAt       DateTime?
  status       NotificationStatus     @default(PENDING)
  createdById  Int
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  createdBy    User                   @relation("NotificationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  recipients   NotificationRecipient[]
  targetTags   NotificationCampaignTag[]

  @@index([status, scheduledFor])
}

model NotificationCampaignTag {
  campaignId Int
  tagId      Int
  campaign   NotificationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  tag        Tag                  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([campaignId, tagId])
}

model NotificationRecipient {
  id           Int                  @id @default(autoincrement())
  campaignId   Int
  userId       Int
  status       NotificationStatus   @default(PENDING)
  deliveredAt  DateTime?
  readAt       DateTime?
  errorMessage String?
  createdAt    DateTime             @default(now())
  campaign     NotificationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([userId, status])
}

model UserDevice {
  id         Int            @id @default(autoincrement())
  userId     Int
  platform   DevicePlatform
  pushToken  String         @unique
  isActive   Boolean        @default(true)
  lastSeenAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, platform])
}

model DailyQuestion {
  id            Int                @id @default(autoincrement())
  questionText  String
  answerType    DailyQuestionType
  options       Json?
  correctAnswer Json?
  points        Decimal            @default(0) @db.Decimal(10, 2)
  activeDate    DateTime           @db.Date
  isActive      Boolean            @default(true)
  createdById   Int
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  createdBy     User               @relation("DailyQuestionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  answers       DailyQuestionAnswer[]

  @@unique([activeDate])
  @@index([isActive, activeDate])
}

model DailyQuestionAnswer {
  id            Int           @id @default(autoincrement())
  questionId    Int
  userId        Int
  answer        Json
  isCorrect     Boolean?
  awardedPoints Decimal       @default(0) @db.Decimal(10, 2)
  isRevealed    Boolean       @default(false)
  revealedAt    DateTime?
  createdAt     DateTime      @default(now())
  question      DailyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([questionId, userId])
  @@index([userId, createdAt])
}
